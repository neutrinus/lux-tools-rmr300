# Copy to secrets.yaml next to snk-mower.yaml and fill in.
wifi_ssid: "your-network"
wifi_password: "your-wifi-password"
ap_password: "fallback-hotspot-password"   # at least 8 characters
api_key: "generate with: openssl rand -base64 32"
mower_pin: "1234"                           # the mower's 4-digit PIN
